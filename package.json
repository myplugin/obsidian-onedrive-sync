{
  "name": "onedrive-vault-sync",
  "version": "0.6.14",
  "description": "Sync your Obsidian vault with OneDrive (personal, App Folder).",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/verify-build.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "deploy": "node scripts/deploy.mjs",
    "format": "npx @biomejs/biome check --write .",
    "clean": "node -e \"require('fs').rmSync('main.js',{force:true})\"",
    "test": "mocha --import=tsx 'tests/**/*.ts'"
  },
  "browser": {
    "path": "path-browserify",
    "process": "process/browser",
    "stream": "stream-browserify",
    "crypto": "crypto-browserify",
    "url": "url/",
    "fs": false,
    "http": false,
    "https": false,
    "net": false,
    "tls": false,
    "vm": false
  },
  "source": "src/main.ts",
  "keywords": [],
  "author": "pef",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/pef/onedrive-sync.git"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@types/chai": "^4.3.16",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.7",
    "@types/mime-types": "^2.1.4",
    "@types/mocha": "^10.0.7",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.5",
    "c8": "^12.0.0",
    "esbuild": "^0.23.0",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "events": "^3.3.0",
    "jsdom": "^24.1.1",
    "mocha": "^10.7.0",
    "npm-check-updates": "^16.14.20",
    "obsidian": "^1.5.7",
    "openapi-typescript": "^7.1.0",
    "tslib": "^2.6.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@azure/msal-node": "^2.12.0",
    "@fyears/rclone-crypt": "^0.0.7",
    "@fyears/tsqueue": "^1.0.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sanity/diff-match-patch": "^3.1.1",
    "aggregate-error": "^5.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "http-status-codes": "^2.3.0",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "localforage-removeitems": "^1.4.0",
    "lodash": "^4.17.21",
    "lucide": "^0.416.0",
    "mime-types": "^2.1.35",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.7",
    "node-diff3": "^3.1.2",
    "openapi-fetch": "^0.10.2",
    "p-queue": "^8.0.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.3",
    "rfc4648": "^1.5.3",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "xregexp": "^5.1.1"
  }
}
